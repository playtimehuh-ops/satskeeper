# Supabase (Project Settings -> API). Service-role key is SECRET: server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the Android app sends in the x-app-key header (generate: openssl rand -hex 24)
APP_KEY=

# HTTP Basic credentials for /api/admin/* (the dashboard in /public)
ADMIN_USER=admin
ADMIN_PASS=

# Economics defaults (overridden by rows in the Supabase `config` table)
PAYOUT_PCT=0.5
POINTS_PER_CENT=1
POINTS_PER_DOLLAR=100
THRESHOLD_POINTS=1000

# manual | bitrefill (bitrefill is intentionally not implemented, see README)
GIFT_CARD_PROVIDER=manual
