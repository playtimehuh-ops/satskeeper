# Supabase credentials. Keep the service-role key server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared app key sent by the Android client; not a strong secret once embedded in the APK.
APP_KEY=

# HTTP Basic authentication for /api/admin/*
ADMIN_USER=admin
ADMIN_PASS=

PAYOUT_PCT=0.5
POINTS_PER_CENT=1
POINTS_PER_DOLLAR=100
THRESHOLD_POINTS=1000
GIFT_CARD_PROVIDER=manual
